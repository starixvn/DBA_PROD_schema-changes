GO

CREATE PROCEDURE [dbo].[Connection_ClientGet_Notification]
AS
BEGIN
	BEGIN TRANSACTION;

	RECEIVE TOP (0) conversation_handle
	FROM [Connection_Notification_Queue];

	IF (
			SELECT COUNT(*)
			FROM [Connection_Notification_Queue]
			WHERE message_type_name = 'http://schemas.microsoft.com/SQL/ServiceBroker/DialogTimer'
			) > 0
	BEGIN
		IF (
				(
					SELECT COUNT(*)
					FROM sys.services
					WHERE NAME = 'Connection_Notification_Service'
					) > 0
				)
			DROP SERVICE [Connection_Notification_Service];

		IF (OBJECT_ID('Connection_Notification_Queue', 'SQ') IS NOT NULL)
			DROP QUEUE [Connection_Notification_Queue];

		DROP PROCEDURE [Connection_ClientGet_Notification];
	END

	COMMIT TRANSACTION;
END

GO

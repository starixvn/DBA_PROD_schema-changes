CREATE PROCEDURE [dbo].[Connection_AssignSite]
	@ConnectionId			INT				= NULL			OUTPUT
	,@SiteId				INT
	,@CurrentUserId			INT
	,@LogDate				DATETIME
	,@LoginIP				VARCHAR(30)		=   ''
	,@Language				VARCHAR(20)		=   'en-us'
	,@ErrCode				INT				=   0			OUTPUT
	,@ErrMsg				NVARCHAR(1000)	=   ''			OUTPUT
AS
/*  
 * Created: 20131701@Edward
 * Task : Insert new connection string
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 
 */
BEGIN
	SET NOCOUNT ON
	
	-- For write log
    DECLARE @startRun	DATETIME  
		,@endRun		DATETIME  
		,@duration		INT
		,@logSPData		VARCHAR(MAX)
		,@logSPDataOld	VARCHAR(MAX)	
		,@xml			XML

	SET @xml = (
		SELECT s.Name	AS	'@n'
		FROM SiteConnection AS sc WITH (NOLOCK)
			INNER JOIN [Site] AS s WITH (NOLOCK) ON sc.SiteId = s.Id			
		WHERE sc.ConnectionId = @ConnectionId
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPDataOld = CONVERT(NVARCHAR(MAX), @xml)

	SET @startRun = GETDATE()

	INSERT INTO SiteConnection(SiteId,ConnectionId) VALUES (@SiteId,@ConnectionId)

	IF @@ERROR > 0
	BEGIN
		SELECT 
			@ErrCode = 1, 
			@ErrMsg = 'Fail to insert assign site to connection ' + CONVERT(VARCHAR(10), @ConnectionId)
		RETURN
	END			
	
	SET @endRun	= GETDATE()  
	SET @duration = DATEDIFF(millisecond, @startRun, @endRun) 

	SET @xml = (
		SELECT s.Name	AS	'@n'		
		FROM [Site] AS s WITH (NOLOCK)		
		WHERE s.Id = @SiteId
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPData = CONVERT(NVARCHAR(MAX), @xml)

	EXEC dbo.LogExecSp_Insert   
		@UserId			= @CurrentUserId
		,@SPName		= 'Connection_AssignSite'		
		,@ObjectId		= @ConnectionId
		,@ObjectTypeId	= 4				-- Object type : Database server		
		,@LogDate		= @LogDate
		,@Data			= @logSPData
		,@OldData		= @logSPDataOld
		,@Duration		= @duration
END	

GO

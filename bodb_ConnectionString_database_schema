CREATE PROCEDURE [dbo].[Connection_SwitchDbServer]
	@ConnectionIds			NVARCHAR(MAX)
	,@ToDbServerId			INT	
	,@Modifier				INT				= NULL
	,@ModifiedDate			DATETIME
	,@CurrentUserId			INT
	,@LogDate				DATETIME
	,@LoginIP				VARCHAR(30)		=   ''
	,@Language				VARCHAR(20)		=   'en-us'
	,@ErrCode				INT				=   0			OUTPUT
	,@ErrMsg				NVARCHAR(1000)	=   ''			OUTPUT
AS
/*  
 * Created: 20131701@Edward
 * Task : Update connection string
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 
 */
BEGIN
	SET NOCOUNT ON
	
	-- For write log
    DECLARE @startRun	DATETIME  
		,@endRun		DATETIME  
		,@duration		INT
		,@logSPData		VARCHAR(MAX)
		,@logSPDataOld	VARCHAR(MAX)	
		,@xml			XML

	DECLARE @TempDatabase TABLE(Name NVARCHAR(150), ServerAlias NVARCHAR(150))
	
	SET @startRun = GETDATE()	

	SET @xml = (
		SELECT	c.Name			AS '@n'
				,ds.Name		AS '@ds'				
		FROM Connection AS c WITH (NOLOCK)
			INNER JOIN DatabaseServer AS ds WITH (NOLOCK) ON c.DbServerId = ds.Id			
		WHERE c.Id IN (SELECT val FROM dbo.strSplit(@ConnectionIds,','))
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPDataOld = CONVERT(NVARCHAR(MAX), @xml)
	
	INSERT INTO @TempDatabase (Name, ServerAlias)
	SELECT d.Name, d.ServerAlias
	FROM Connection AS c WITH(NOLOCK)
		INNER JOIN [Database] AS d WITH(NOLOCK) ON d.Id = c.DatabaseId
	WHERE c.Id IN (SELECT val FROM dbo.strSplit(@ConnectionIds,','))
	AND NOT EXISTS(	SELECT TOP(1) * FROM [Database] AS t 
			WHERE t.DbServerId = @ToDbServerId AND t.Name = d.Name AND t.ServerAlias = d.ServerAlias)	

	IF EXISTS (SELECT TOP(1) * FROM @TempDatabase)
	BEGIN
		SELECT @ErrMsg = COALESCE(@ErrMsg + '</br>', '') + 'Database Name : '+d.Name +' - Server Alias : ' +d.ServerAlias
		FROM @TempDatabase AS d

		SELECT @ErrCode = 1

		RETURN 
	END
	UPDATE Connection SET DbServerId = @ToDbServerId
	WHERE Id IN (SELECT val FROM dbo.strSplit(@ConnectionIds,','))

	SET @endRun	= GETDATE()  
	SET @duration = DATEDIFF(millisecond, @startRun, @endRun)

	SET @xml = (
		SELECT	c.Name			AS '@n'
				,ds.Name		AS '@ds'				
		FROM Connection AS c WITH (NOLOCK)
			INNER JOIN DatabaseServer AS ds WITH (NOLOCK) ON c.DbServerId = ds.Id			
		WHERE c.Id IN (SELECT val FROM dbo.strSplit(@ConnectionIds,','))
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPData = CONVERT(NVARCHAR(MAX), @xml)
	

CREATE PROCEDURE [dbo].[Site_UpdateStatus]
	@SiteId			INT	
	,@IsActive		BIT
	,@Modifier		INT				= NULL
	,@ModifiedDate	DATETIME
	,@CurrentUserId	INT
	,@LogDate		DATETIME
	,@LoginIP		VARCHAR(30)		=   ''
	,@Language		VARCHAR(20)		=   'en-us'
	,@ErrCode		INT				=   0			OUTPUT
	,@ErrMsg		NVARCHAR(1000)	=   ''			OUTPUT
AS
/*  
 * Created: 20131701@Edward
 * Task : update status of site
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 
 */

BEGIN
	SET NOCOUNT ON

	-- For write log
    DECLARE @startRun	DATETIME  
		,@endRun		DATETIME  
		,@duration		INT
		,@logSPData		VARCHAR(MAX)
		,@logSPDataOld	VARCHAR(MAX)	
		,@xml			XML	

	SET @startRun = GETDATE()

	SET @xml = (
		SELECT	Name			AS '@n'								
				,IsActive		AS '@s'		
		FROM [Site] WITH (NOLOCK)
		WHERE Id = @SiteId
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPDataOld = CONVERT(NVARCHAR(MAX), @xml)
	
	-- Update information
	UPDATE [Site] SET		
		IsActive	= @IsActive,
		Modifier	= @Modifier,
		ModifiedDate= @ModifiedDate
	WHERE Id = @SiteId

	IF @@ERROR > 0
	BEGIN
		SELECT 
			@ErrCode = 1, 
			@ErrMsg = 'Fail to update Site ' + CONVERT(VARCHAR(10), @SiteId)
		RETURN
	END	

	SET @endRun	= GETDATE()  
	SET @duration = DATEDIFF(millisecond, @startRun, @endRun) 

	SET @xml = (
		SELECT	Name			AS '@n'								
				,IsActive		AS '@s'		
		FROM [Site] WITH (NOLOCK)
		WHERE Id = @SiteId
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPData = CONVERT(NVARCHAR(MAX), @xml)

	EXEC dbo.LogExecSp_Insert   
		@UserId			= @CurrentUserId
		,@SPName		= 'Site_UpdateStatus'		
		,@ObjectId		= @SiteId			
		,@ObjectTypeId	= 3				-- Object type : Database server		
		,@LogDate		= @LogDate
		,@Data			= @logSPData
		,@OldData		= @logSPDataOld
		,@Duration		= @duration	
END

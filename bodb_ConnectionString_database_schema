CREATE PROCEDURE [dbo].[Connection_GetAll]
	@DbServerId		INT		= 0
AS
/*  
 * Created: 20131701@Edward
 * Task : Get connection string by id
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 
 */
BEGIN
	SET NOCOUNT ON	

	SELECT c.Id
			,c.Name
			,c.LoginName
			,c.Password
			,c.[FreeText]
			,c.IsActive
			,c.CreatedDate
			,c.ModifiedDate
			,c.Creator		AS CreatorId
			,uc.username	AS CreatorUsername
			,c.Modifier		AS ModifierId
			,um.username	AS ModifierUsername
			,c.DbServerId	
			,d.Name			AS ServerName			 
			,c.DatabaseId
			,ad.Name		AS DatabaseName	
			,ad.ServerAlias
	FROM Connection AS c WITH (NOLOCK)
		LEFT JOIN bodb02.dbo.custInfo AS uc WITH (NOLOCK) ON c.Creator = uc.custid
		LEFT JOIN bodb02.dbo.custInfo AS um WITH (NOLOCK) ON c.Modifier = um.custid
		INNER JOIN [Database] AS ad WITH (NOLOCK) ON c.DatabaseId = ad.Id
		INNER JOIN DatabaseServer AS d WITH (NOLOCK) ON c.DbServerId = d.Id
	WHERE ( @DbServerId = 0 OR (@DbServerId <> 0 AND c.DbServerId = @DbServerId))
		
END

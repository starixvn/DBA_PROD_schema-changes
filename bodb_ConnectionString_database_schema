CREATE PROCEDURE [dbo].[Connection_Insert]
	@ConnectionId			INT				= NULL			OUTPUT
	,@Name					NVARCHAR(150)
	,@DbServerId			INT
	,@DatabaseId			INT	
	,@LoginName				NVARCHAR(300)	= ''
	,@Password				NVARCHAR(350)	= ''
	,@FreeText				NVARCHAR(350)	= ''	
	,@IsActive				BIT
	,@Creator				INT				= NULL
	,@CreatedDate			DATETIME
	,@CurrentUserId			INT
	,@LogDate				DATETIME
	,@LoginIP				VARCHAR(30)		=   ''
	,@Language				VARCHAR(20)		=   'en-us'
	,@ErrCode				INT				=   0			OUTPUT
	,@ErrMsg				NVARCHAR(1000)	=   ''			OUTPUT
AS
/*  
 * Created: 20131701@Edward
 * Task : Insert new connection string
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 
 */
BEGIN
	SET NOCOUNT ON
	
	-- For write log
    DECLARE @startRun	DATETIME  
		,@endRun		DATETIME  
		,@duration		INT
		,@logSPData		VARCHAR(MAX)
		,@logSPDataOld	VARCHAR(MAX)	
		,@xml			XML

	SET @startRun = GETDATE()

	INSERT INTO Connection(
			Name,
			DbServerId,
			DatabaseId,			
			LoginName,
			Password,
			[FreeText],			
			IsActive,
			Creator,
			CreatedDate,
			Modifier,
			ModifiedDate)
	VALUES(
			@Name,
			@DbServerId,
			@DatabaseId,
			@LoginName,
			@Password,
			@FreeText,			
			@IsActive,
			@Creator,
			@CreatedDate,
			@Creator,
			@CreatedDate)

	SET @ConnectionId = SCOPE_IDENTITY()
	
	IF @@ERROR > 0
	BEGIN
		SELECT 
			@ErrCode = 1, 
			@ErrMsg = 'Fail to insert new Connection ' + CONVERT(VARCHAR(10), @ConnectionId)
		RETURN
	END			

	SET @endRun	= GETDATE()  
	SET @duration = DATEDIFF(millisecond, @startRun, @endRun) 

	SET @xml = (
		SELECT	c.Name			AS '@n'
				,ds.Name		AS '@ds'
				,d.Name			AS '@d'
				,d.ServerAlias	AS '@sa'
				,c.LoginName	AS '@ln'
				,c.Password		AS '@p'
				,c.[FreeText]	AS '@ft'
				,c.IsActive		AS '@s'
		FROM Connection AS c WITH (NOLOCK)
			INNER JOIN DatabaseServer AS ds WITH (NOLOCK) ON c.DbServerId = ds.Id
			INNER JOIN [Database] AS d WITH (NOLOCK) ON c.DatabaseId = d.Id
		WHERE c.Id = @ConnectionId
		FOR XML PATH('z'), ROOT('r')
	)	

	SET @logSPData = CONVERT(NVARCHAR(MAX), @xml)

	EXEC dbo.LogExecSp_Insert   
		@UserId			= @CurrentUserId
		,@SPName		= 'Connection_Insert'		
		,@ObjectId		= @ConnectionId
		,@ObjectTypeId	= 4				-- Object type : Database server		
		,@LogDate		= @LogDate
		,@Data			= @logSPData
		,@OldData		= @logSPDataOld
		,@Duration		= @duration
END	
GO

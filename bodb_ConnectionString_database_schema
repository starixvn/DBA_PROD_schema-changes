CREATE PROCEDURE [dbo].[LogExecSp_Search]
	@Username		NVARCHAR(50) = ''
    ,@Name			NVARCHAR(50) = ''
    ,@FilterType    INT
    ,@From			DATETIME
	,@To			DATETIME
	,@PageIndex		INT
	,@PageSize		INT
	,@TotalRows		INT	= 0	OUTPUT	
AS
/*  
 * Created: 20130128@Edward
 * Task : Search execute SP log
 * DB: bodb_NAP
 *  
 * Revisions:     
 * Param's Explanation: 
*/
BEGIN
	SET NOCOUNT ON

	DECLARE @FirstRec INT, 
			@LastRec INT

	SELECT @FirstRec = ((@PageIndex - 1) * @PageSize) + 1
	SELECT @LastRec = ((@PageIndex * @PageSize + 1)) - 1
	
	DECLARE @TempData TABLE (Id INT, Name NVARCHAR(150))

	IF @FilterType = 1
	BEGIN
		INSERT INTO @TempData(Id, Name)
		SELECT Id, Name 
		FROM DatabaseServer WITH (NOLOCK)
		WHERE Name LIKE '%' + ISNULL(@Name,'') + '%' 
	END

	IF @FilterType = 2
	BEGIN
		INSERT INTO @TempData(Id, Name)
		SELECT Id, Name 
		FROM [Database] WITH (NOLOCK)
		WHERE Name LIKE '%' + ISNULL(@Name,'') + '%' 
	END

	IF @FilterType = 3
	BEGIN
		INSERT INTO @TempData(Id, Name)
		SELECT Id, Name 
		FROM [Site] WITH (NOLOCK)
		WHERE Name LIKE '%' + ISNULL(@Name,'') + '%' 
	END

	IF @FilterType = 4
	BEGIN
		INSERT INTO @TempData(Id, Name)
		SELECT Id, Name 
		FROM Connection WITH (NOLOCK)
		WHERE Name LIKE '%' + ISNULL(@Name,'') + '%' 
	END

	-- gets total rows
	SET @TotalRows = (
		SELECT COUNT(1)
		FROM LogExecSp AS lg WITH (NOLOCK)
			LEFT JOIN @TempData AS t ON t.Id = lg.ObjectId
			LEFT JOIN bodb02.dbo.custInfo AS cu WITH (NOLOCK) ON lg.UserId = cu.custid					
			INNER JOIN LogAction AS la WITH (NOLOCK) ON lg.ActionId = la.ActionId
		WHERE 
			lg.ObjectTypeId = @FilterType			
			AND lg.LogDate BETWEEN @From AND @To
			AND ISNULL(cu.username,'') LIKE '%' + ISNULL(@Username,'') + '%'
	)

	-- gets data
	SELECT TOP (@PageSize) *
	FROM (
			SELECT 
				lg.Id,
				lg.LogDate,
				t.Name,
				cu.username AS Modifier,
				la.ActionId,
				la.ActionName,				
				lg.OldData,
				lg.Data,
				la.ActionTypeId,
				row_number() OVER (ORDER BY lg.LogDate DESC) AS num
			FROM 
				LogExecSp AS lg WITH (NOLOCK)
				LEFT JOIN @TempData AS t ON t.Id = lg.ObjectId
				LEFT JOIN bodb02.dbo.custInfo AS cu WITH (NOLOCK) ON lg.UserId = cu.custid										
				INNER JOIN LogAction AS la WITH (NOLOCK) ON lg.ActionId = la.ActionId
			WHERE 
				lg.ObjectTypeId = @FilterType				
				AND lg.LogDate BETWEEN @From AND @To
				AND ISNULL(cu.username,'') LIKE '%' + ISNULL(@Username,'') + '%'
		) AS Temp
	WHERE
		Temp.num >= @FirstRec
		AND Temp.num <= @LastRec
	ORDER BY
		Temp.num	
END
GO

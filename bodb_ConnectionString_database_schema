CREATE PROCEDURE [dbo].[Connection_ClientGet]
AS
/*  
 * Created: 20131701@Edward
 * Task : get connection string
 * DB: bodb_ConnectionString
 *  
 * Revisions:     
 * Param's Explanation: 	
	Follow rule of sql dependency
 */
BEGIN

	SELECT 	[Connection].Id
			,[Connection].Name
			,[DatabaseServer].ServerIP
			,[Database].Name	AS DatabaseName
			,[Connection].LoginName
			,[Connection].Password
			,[Connection].[FreeText]
			,[SiteConnection].SiteId
	FROM dbo.[Connection]
		INNER JOIN dbo.[DatabaseServer] ON [Connection].DbServerId = [DatabaseServer].Id
		INNER JOIN dbo.[Database] ON [Connection].DatabaseId = [Database].Id
		INNER JOIN dbo.[SiteConnection] ON [Connection].Id = [SiteConnection].ConnectionId
	WHERE [Connection].IsActive			= 1
		AND [DatabaseServer].IsActive	= 1
		AND [Database].IsActive			= 1		
END	   
